# =============================================================================
# TRADING PORTAL — LOCAL DEVELOPMENT (.env)
# =============================================================================

# Server Port (Use 5001 so it doesn't conflict with climeto-backend on 5000)
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/trading_portal?retryWrites=true&w=majority

# JWT Secret Key for Trading Portal Sessions
JWT_SECRET=trading_portal_jwt_secret_dev_key_2026

# Central Climeto Auth API URL (Used to verify SSO tokens from climeto-portal)
CLIMETO_API_URL=http://localhost:5000

# Frontend Variables (Vite)
# In local dev: leave VITE_API_URL empty if using Vite proxy, or set to http://localhost:5001
VITE_API_URL=http://localhost:5001
VITE_PORTAL_URL=http://localhost:5173
